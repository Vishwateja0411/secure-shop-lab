# ==============================================================================
# SECURESHOP LAB CONFIGURATION
# ==============================================================================

# Toggle lab mode:
# false = Intentionally Vulnerable Lab (Default for training)
# true  = Hardened Secure Mode
SECURE_MODE=false

# Application Secrets
SECRET_KEY=lab_insecure_default_secret_key_change_in_production_123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL in Docker, SQLite fallback for local test runner)
DATABASE_URL=postgresql://secureshop:secureshop_password@postgres:5432/secureshop_db

# File Storage
UPLOAD_DIR=/app/uploads
INVOICE_DIR=/app/invoices

# Application URLs
BACKEND_PORT=8000
FRONTEND_PORT=80
HOST=0.0.0.0
